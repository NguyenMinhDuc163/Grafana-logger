LOG_RETENTION=2d
LOG_MAX_DISK=1GiB

# Use the observability LXC private-LAN IP so Vector agents can reach port 9428.
VICTORIALOGS_BIND_ADDRESS=10.10.1.20
VICTORIALOGS_PORT=9428
VICTORIALOGS_MEMORY_LIMIT=1g

GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_LOGGING_IMAGE=nguyenduc1603/central-logging:grafana-latest
GRAFANA_MEMORY_LIMIT=384m
