LOG_RETENTION=14d

GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<replace-with-strong-password>

OTEL_COLLECTOR_IMAGE=nguyenduc1603/central-logging:otel-latest
VICTORIALOGS_IMAGE=nguyenduc1603/central-logging:victorialogs-latest
GRAFANA_LOGGING_IMAGE=nguyenduc1603/central-logging:grafana-latest

VECTOR_MEMORY_LIMIT=192m
OTEL_MEMORY_LIMIT=384m
VICTORIALOGS_MEMORY_LIMIT=1g
GRAFANA_MEMORY_LIMIT=384m
